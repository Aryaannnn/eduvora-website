# =====================================================================
#  EDUVORA — ENVIRONMENT VARIABLES (names only, NO real values here)
#
#  On your computer: copy this file to ".env.local" and fill in the values.
#  On Vercel: Project → Settings → Environment Variables → add each name
#  below with its real value (for "Production", and "Preview" if you use it).
#
#  NEXT_PUBLIC_…  = safe to show in the browser (public).
#  Everything else = SECRET — stays on the server only. Never share it,
#  never put it in code, never add NEXT_PUBLIC_ in front of it.
# =====================================================================

# ---------- Website ----------
# Your live website address, e.g. https://www.your-domain.com  (no slash at the end)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Supabase → Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# (Older Supabase projects call the key above the "anon" key — the website also accepts
#  it under the name NEXT_PUBLIC_SUPABASE_ANON_KEY. You only need ONE of the two.)
# SECRET — server only (marks payments as paid, file uploads, emails). Starts with sb_secret_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Razorpay (Dashboard → Account & Settings → API Keys) ----------
# Use rzp_test_… keys for testing, rzp_live_… keys when you go live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# SECRET
RAZORPAY_KEY_SECRET=
# SECRET — the text you choose when creating the webhook (Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Emails (Resend → API Keys) ----------
# SECRET
RESEND_API_KEY=
# Where "new payment / booking / enquiry" emails for you are sent
ADMIN_EMAIL=

# ---------- Private contact number ----------
# SECRET-ish: your full phone number. The full number and the Call button are
# only shown to students who paid. WhatsApp CHAT uses it for everyone.
CONTACT_PHONE=
# OPTIONAL: a different number just for WhatsApp chat (e.g. a business WhatsApp).
# Leave empty to use CONTACT_PHONE for WhatsApp too.
WHATSAPP_PHONE=+91XXXXXXXXXX

# ---------- Scheduled jobs (payment check + session reminders) ----------
# SECRET — any long random text (40+ characters). Vercel Cron sends it automatically.
CRON_SECRET=
